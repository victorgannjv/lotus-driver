# Custom environment variables & secrets for your app.
#
# Substrait reads this file when you upload the app and PRE-CREATES each entry under
# the app's Settings (Environment variables / Secrets), so after uploading you just
# fill in the real values in the portal — no redeploy needed for the values to apply.
#
#   NAME=value            → an environment variable, prefilled with `value`
#   NAME=value   # secret → a secret (write-only; masked in the portal)
#
# Notes:
#   - The value after `=` is the prefilled placeholder (may be left empty).
#   - Quote values that contain a literal `#` so it isn't read as a comment.
#   - DO NOT list DATABASE_URL, REDIS_URL or JWT_SECRET — the platform injects those.
#   - Read these at runtime from the environment (os.getenv); never commit real secrets.
#   - Re-uploading never overwrites a value you've already set in the portal.

# Anthropic API key used for Claude vision OCR (manifest photos + delivery order slips).
ANTHROPIC_API_KEY=   # secret

# Claude model id used for OCR calls (must support vision/image input).
OCR_MODEL=claude-sonnet-5

# How many days a driver's login JWT stays valid before they must log in again.
JWT_EXPIRY_DAYS=14

# Local-dev/testing only: when true, OCR calls return canned fixture data instead of
# calling the Anthropic API, so the manifest/check-in flow can be exercised without
# spending API credits or needing legible test photos. Leave false/unset in production.
OCR_MOCK=false

# SMTP relay used to send "forgot password" reset-link emails. Works with any relay
# that supports STARTTLS on the given port (a corporate mail relay, Office 365, Gmail
# SMTP, or a transactional email provider's SMTP interface).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=   # secret
SMTP_PASSWORD=   # secret
# From address for reset emails. Defaults to SMTP_USER if left blank.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Lotus Driver Tracking
