# Frontend image for Substrait: build the Vite app, then serve the static bundle with
# nginx on port 80. Built from the REPO ROOT, so COPY paths are repo-relative.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ .
# Same-origin API: the ingress routes /api to the backend, so the app calls the backend
# via relative /api paths — no absolute URL is baked into the bundle.
ENV VITE_API_URL=""
RUN npm run build

FROM nginx:1.27-alpine
# Patch known-vulnerable Alpine base packages ahead of what nginx:1.27-alpine ships,
# rather than pin a newer nginx tag that may bundle its own new CVEs unreviewed.
RUN apk update && apk add --no-cache \
    "c-ares>=1.34.8-r0" \
    "libcrypto3>=3.3.7-r1" \
    "libssl3>=3.3.7-r1" \
    "libexpat>=2.8.4-r0" \
    "libpng>=1.6.55-r0" \
    "libxml2>=2.13.9-r1"
COPY --from=build /app/dist /usr/share/nginx/html
COPY cicd/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
