{
  "openapi": "3.0.3",
  "info": {
    "title": "Lotus Driver Tracking System",
    "description": "Backend for driver signup/login, barcode-scan order registration and delivery completion (GPS + timestamp logged per scan), and an SSO-gated admin dashboard for reviewing driver activity.",
    "version": "2.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness/readiness probe used by the platform.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service is up.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "status": { "type": "string", "example": "ok" } } }
              }
            }
          }
        }
      }
    },
    "/api/auth/signup": {
      "post": {
        "summary": "Register a new driver account and issue a login JWT.",
        "operationId": "signup",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SignupRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Account created.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } }
          },
          "409": { "description": "An account with this email already exists." }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Log in a driver with email + password and issue a JWT.",
        "operationId": "login",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Login succeeded.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } }
          },
          "401": { "description": "Invalid email or password." },
          "403": { "description": "This account is disabled." }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "summary": "Request a password-reset link by email; always returns a generic response so the endpoint can't be used to enumerate accounts.",
        "operationId": "forgotPassword",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ForgotPasswordRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Always returned, whether or not the email has an account.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "message": { "type": "string" } } }
              }
            }
          }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "summary": "Complete a password reset using the token from the emailed link, and log the driver in.",
        "operationId": "resetPassword",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResetPasswordRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Password updated; a fresh login JWT is issued.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } }
          },
          "400": { "description": "The reset link is invalid, already used, or expired." }
        }
      }
    },
    "/api/scans/register": {
      "post": {
        "summary": "Register an order by its scanned barcode at pickup; creates today's scan session on first use and creates the job on first scan of that code (a repeat scan is a no-op, not an error).",
        "operationId": "registerScan",
        "tags": ["driver"],
        "security": [{ "driverBearer": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScanRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Registered (or already was).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScanRegisterResult" } } }
          },
          "409": { "description": "That code was already delivered or was cancelled." },
          "422": { "description": "Scanned code is empty." }
        }
      }
    },
    "/api/scans/complete": {
      "post": {
        "summary": "Mark an order delivered by scanning the same barcode again; logs a delivered event with timestamp + GPS.",
        "operationId": "completeScan",
        "tags": ["driver"],
        "security": [{ "driverBearer": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScanRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Marked delivered.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScanCompleteResult" } } }
          },
          "404": { "description": "That code hasn't been registered yet." },
          "409": { "description": "That code was already delivered or was cancelled." },
          "422": { "description": "Scanned code is empty." }
        }
      }
    },
    "/api/warehouse-arrival": {
      "post": {
        "summary": "Record the driver's warehouse-arrival time for today (first call of the day wins; later calls are a no-op).",
        "operationId": "logWarehouseArrival",
        "tags": ["driver"],
        "security": [{ "driverBearer": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArrivalRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Today's session, with warehouse_arrived_at set if this was the first call of the day.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "manifest": { "$ref": "#/components/schemas/Manifest" } } }
              }
            }
          }
        }
      }
    },
    "/api/manifests": {
      "get": {
        "summary": "List the current driver's scan sessions, most recent work date first.",
        "operationId": "listManifests",
        "tags": ["driver"],
        "security": [{ "driverBearer": [] }],
        "responses": {
          "200": {
            "description": "Session list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "manifests": { "type": "array", "items": { "$ref": "#/components/schemas/Manifest" } } }
                }
              }
            }
          }
        }
      }
    },
    "/api/manifests/{manifest_id}": {
      "get": {
        "summary": "Get one scan session belonging to the current driver, with its registered/delivered jobs.",
        "operationId": "getManifest",
        "tags": ["driver"],
        "security": [{ "driverBearer": [] }],
        "parameters": [{ "name": "manifest_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "Session and its jobs.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "manifest": { "$ref": "#/components/schemas/Manifest" },
                    "jobs": { "type": "array", "items": { "$ref": "#/components/schemas/Job" } }
                  }
                }
              }
            }
          },
          "404": { "description": "Session not found." }
        }
      }
    },
    "/api/manifests/{manifest_id}/cancel": {
      "post": {
        "summary": "Cancel a scan session (e.g. the wrong load got scanned in) so the driver can start clean; refused once any of its jobs has been delivered.",
        "operationId": "cancelManifest",
        "tags": ["driver"],
        "security": [{ "driverBearer": [] }],
        "parameters": [{ "name": "manifest_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "Session cancelled; its still-registered jobs are marked cancelled too.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "manifest": { "$ref": "#/components/schemas/Manifest" } } }
              }
            }
          },
          "404": { "description": "Session not found." },
          "409": { "description": "Already cancelled, or has completed deliveries and can't be cancelled." }
        }
      }
    },
    "/api/jobs/{job_id}/events": {
      "get": {
        "summary": "List the chronological scan events (registered, delivered) for one of the current driver's jobs.",
        "operationId": "listJobEvents",
        "tags": ["driver"],
        "security": [{ "driverBearer": [] }],
        "parameters": [{ "name": "job_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "Event list, oldest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "events": { "type": "array", "items": { "$ref": "#/components/schemas/Event" } } }
                }
              }
            }
          },
          "404": { "description": "Job not found." }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "Report the caller's identity from the platform's SSO header, if any, and whether they're an admin.",
        "operationId": "me",
        "tags": ["common"],
        "responses": {
          "200": {
            "description": "Identity check (public endpoint; the admin frontend uses this to decide whether to render).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "email": { "type": "string", "nullable": true },
                    "is_admin": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/statuses": {
      "get": {
        "summary": "List the active job status codes (registered, delivered, cancelled).",
        "operationId": "listStatuses",
        "tags": ["common"],
        "security": [{ "driverBearer": [] }, { "adminSSO": [] }],
        "responses": {
          "200": {
            "description": "Status list, in display order.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "statuses": { "type": "array", "items": { "$ref": "#/components/schemas/Status" } } }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/drivers": {
      "get": {
        "summary": "List all drivers, most recently registered first.",
        "operationId": "adminListDrivers",
        "tags": ["admin"],
        "security": [{ "adminSSO": [] }],
        "responses": {
          "200": {
            "description": "Driver list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "drivers": { "type": "array", "items": { "$ref": "#/components/schemas/Driver" } } }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/jobs": {
      "get": {
        "summary": "List delivery jobs across all drivers, filterable by status, driver, session and date range.",
        "operationId": "adminListJobs",
        "tags": ["admin"],
        "security": [{ "adminSSO": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "driver_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "manifest_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "date_from", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "date_to", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 50 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated job list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobs": { "type": "array", "items": { "$ref": "#/components/schemas/AdminJob" } },
                    "page": { "type": "integer" },
                    "page_size": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/jobs/{job_id}": {
      "get": {
        "summary": "Get full detail for one delivery job, including its session and driver.",
        "operationId": "adminGetJob",
        "tags": ["admin"],
        "security": [{ "adminSSO": [] }],
        "parameters": [{ "name": "job_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "Job detail.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "job": { "$ref": "#/components/schemas/AdminJobDetail" } } }
              }
            }
          },
          "404": { "description": "Job not found." }
        }
      }
    },
    "/api/admin/jobs/{job_id}/events": {
      "get": {
        "summary": "Get the full chronological scan-event log for a job (timestamp, status, GPS).",
        "operationId": "adminGetJobEvents",
        "tags": ["admin"],
        "security": [{ "adminSSO": [] }],
        "parameters": [{ "name": "job_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "Event list, oldest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "events": { "type": "array", "items": { "$ref": "#/components/schemas/AdminEvent" } } }
                }
              }
            }
          },
          "404": { "description": "Job not found." }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "summary": "List admin users on the SSO allowlist, oldest first.",
        "operationId": "adminListAdmins",
        "tags": ["admin"],
        "security": [{ "adminSSO": [] }],
        "responses": {
          "200": {
            "description": "Admin list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "admins": { "type": "array", "items": { "$ref": "#/components/schemas/AdminUser" } } }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add a new admin user to the SSO allowlist.",
        "operationId": "adminAddAdmin",
        "tags": ["admin"],
        "security": [{ "adminSSO": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddAdminRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Admin added.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "id": { "type": "integer" }, "email": { "type": "string" }, "name": { "type": "string" } }
                }
              }
            }
          },
          "409": { "description": "A user with this email already exists." }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "driverBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Driver JWT from /api/auth/signup or /api/auth/login, signed with the platform's JWT_SECRET."
      },
      "adminSSO": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Forwarded-Email",
        "description": "Injected by the Substrait platform's Google SSO proxy when SSO is enabled for this app in the portal's Access tab; not client-supplied. The caller must also be on the admin allowlist in the users table."
      }
    },
    "schemas": {
      "SignupRequest": {
        "type": "object",
        "required": ["email", "password", "name"],
        "properties": {
          "email": { "type": "string" },
          "password": { "type": "string" },
          "name": { "type": "string" },
          "phone": { "type": "string", "nullable": true }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": { "email": { "type": "string" }, "password": { "type": "string" } }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "required": ["email"],
        "properties": { "email": { "type": "string" } }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": ["token", "new_password"],
        "properties": { "token": { "type": "string" }, "new_password": { "type": "string" } }
      },
      "AddAdminRequest": {
        "type": "object",
        "required": ["email", "name"],
        "properties": { "email": { "type": "string" }, "name": { "type": "string" } }
      },
      "ScanRequest": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "description": "The decoded barcode value." },
          "lat": { "type": "number", "nullable": true },
          "lng": { "type": "number", "nullable": true },
          "occurred_at": { "type": "string", "format": "date-time", "nullable": true, "description": "ISO 8601; defaults to server time if omitted." }
        }
      },
      "ArrivalRequest": {
        "type": "object",
        "properties": {
          "lat": { "type": "number", "nullable": true },
          "lng": { "type": "number", "nullable": true },
          "occurred_at": { "type": "string", "format": "date-time", "nullable": true, "description": "ISO 8601; defaults to server time if omitted." }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "user": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "email": { "type": "string" },
              "name": { "type": "string" }
            }
          }
        }
      },
      "ScanRegisterResult": {
        "type": "object",
        "properties": {
          "job_id": { "type": "integer" },
          "manifest_id": { "type": "integer" },
          "tracking_no": { "type": "string" },
          "already_registered": { "type": "boolean" }
        }
      },
      "ScanCompleteResult": {
        "type": "object",
        "properties": {
          "job_id": { "type": "integer" },
          "tracking_no": { "type": "string" }
        }
      },
      "Manifest": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "work_date": { "type": "string", "format": "date" },
          "cancelled_at": { "type": "string", "nullable": true },
          "warehouse_arrived_at": { "type": "string", "nullable": true },
          "warehouse_arrived_lat": { "type": "number", "nullable": true },
          "warehouse_arrived_lng": { "type": "number", "nullable": true },
          "created_at": { "type": "string" }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "tracking_no": { "type": "string" },
          "status_code": { "type": "string", "enum": ["registered", "delivered", "cancelled"] },
          "created_at": { "type": "string" }
        }
      },
      "AdminJob": {
        "allOf": [
          { "$ref": "#/components/schemas/Job" },
          {
            "type": "object",
            "properties": {
              "work_date": { "type": "string", "format": "date" },
              "driver_id": { "type": "integer" },
              "driver_name": { "type": "string" }
            }
          }
        ]
      },
      "AdminJobDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "tracking_no": { "type": "string" },
          "status_code": { "type": "string", "enum": ["registered", "delivered", "cancelled"] },
          "created_at": { "type": "string" },
          "manifest_id": { "type": "integer" },
          "work_date": { "type": "string", "format": "date" },
          "warehouse_arrived_at": { "type": "string", "nullable": true },
          "driver_id": { "type": "integer" },
          "driver_name": { "type": "string" },
          "driver_email": { "type": "string" }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "status_code": { "type": "string", "enum": ["registered", "delivered"] },
          "occurred_at": { "type": "string" },
          "lat": { "type": "number", "nullable": true },
          "lng": { "type": "number", "nullable": true }
        }
      },
      "AdminEvent": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "job_id": { "type": "integer" },
          "driver_id": { "type": "integer" },
          "status_code": { "type": "string", "enum": ["registered", "delivered"] },
          "occurred_at": { "type": "string" },
          "lat": { "type": "number", "nullable": true },
          "lng": { "type": "number", "nullable": true }
        }
      },
      "Status": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "label": { "type": "string" },
          "is_terminal_success": { "type": "boolean" }
        }
      },
      "Driver": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["active", "disabled"] },
          "created_at": { "type": "string" }
        }
      },
      "AdminUser": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "disabled"] },
          "created_at": { "type": "string" }
        }
      }
    }
  }
}
